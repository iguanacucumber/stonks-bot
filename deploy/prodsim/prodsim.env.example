# v12 production simulation environment.
#
# Copy to /etc/stonks-prodsim/env (root:stonks, 0600) and replace the token.
# Never commit a real token. This service has no real broker credentials and
# no live order path: the only exchange is the in-process simulation.

# Bearer token for /api/v1/*. Required outside --dev.
STONKS_PRODSIM_API_TOKEN=replace-with-a-long-random-token

# Optional overrides read by the CLI. The systemd unit passes the state dir
# explicitly; keep it on a filesystem included in the backup job.
STONKS_PRODSIM_STATE_DIR=/var/lib/stonks-prodsim
STONKS_PRODSIM_CACHE_DIR=/opt/stonks-bot/cache

# Paper-simulation account. Simulated money only.
PRODSIM_CAPITAL=100000

# Replay / data pacing.
PRODSIM_SPEED=1
PRODSIM_MAX_STALE_DAYS=3
PRODSIM_POLL_SECONDS=30

# Loopback only. Do not expose the API through a public interface without a
# reverse proxy and TLS; the token is static.
PRODSIM_API_HOST=127.0.0.1
PRODSIM_API_PORT=8080
