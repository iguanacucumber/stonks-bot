# IBKR Client Portal Web API paper adapter.
# Copy to .env, export the values in your shell, or use your process manager.
# The gateway owns login/2FA; no OAuth token or password belongs in this file.
IBKR_PAPER_ACCOUNT=DU0000000
IBKR_PAPER_BASE_URL=https://localhost:5000/v1/api
IBKR_PAPER_TIMEOUT=15
IBKR_PAPER_POLL_INTERVAL=1
IBKR_PAPER_MAX_POLL=30
IBKR_PAPER_MAX_RETRIES=3
IBKR_PAPER_BACKOFF=0.5
IBKR_PAPER_VERIFY_SSL=true
